#!/bin/sh
# Export this project's Engram memories into .engram/ and stage them, so every
# commit carries the team memory. Skips silently when engram is not installed.
if ! command -v engram >/dev/null 2>&1; then
  echo "[engram] not installed; skipping memory export" >&2
  exit 0
fi
engram sync >/dev/null 2>&1 || { echo "[engram] sync failed; committing without memory export" >&2; exit 0; }
git add .engram/ 2>/dev/null
exit 0
