# PostgreSQL connection string used by Drizzle ORM
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/justifia"

# Active brand palette: "uam" (default) or "fia" (Facultad de Ingeniería)
NEXT_PUBLIC_BRAND="uam"

# JWT signing secret for the session cookie (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-32-plus-char-random-string"
